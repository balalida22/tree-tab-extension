{
  "manifest_version": 3,
  "name": "Tree Tabs",
  "version": "1.0.0",
  "description": "Organize Firefox tabs in a vertical tree sidebar.",
  "icons": {
    "32": "icons/tree-tabs.svg"
  },
  "permissions": [
    "tabs",
    "contextMenus",
    "storage"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Toggle Tree Tabs",
    "default_icon": {
      "16": "icons/tree-tabs.svg",
      "32": "icons/tree-tabs.svg"
    }
  },
  "sidebar_action": {
    "default_title": "Tree Tabs",
    "default_panel": "sidebar.html",
    "default_icon": "icons/tree-tabs.svg",
    "open_at_install": true
  },
  "commands": {
    "new-top-level-tab": {
      "suggested_key": {
        "default": "Ctrl+Alt+T"
      },
      "description": "Open a new top-level tab"
    },
    "new-child-tab": {
      "suggested_key": {
        "default": "Ctrl+Alt+Shift+T"
      },
      "description": "Open a child tab under the active tab"
    },
    "close-tree": {
      "suggested_key": {
        "default": "Ctrl+Alt+W"
      },
      "description": "Close the active tab and its descendants"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tree-tabs@example.com",
      "strict_min_version": "121.0"
    }
  }
}
